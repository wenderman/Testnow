# PostgreSQL
POSTGRES_DB=habits
POSTGRES_USER=habits_user
POSTGRES_PASSWORD=changeme

# Backend
DATABASE_URL=postgresql://habits_user:changeme@db:5432/habits
SECRET_KEY=change-me-in-production

# VAPID keys for Web Push notifications
# Generate with: docker compose run --rm backend python generate_vapid.py
# Private key: PEM content with actual newlines replaced by literal \n
VAPID_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nMHQCAQEE<your-key-here>\n-----END EC PRIVATE KEY-----\n
VAPID_PUBLIC_KEY=<url-safe-base64-public-key>
VAPID_EMAIL=your@email.com

# Frontend / Nginx (exposed host port)
FRONTEND_PORT=80
BACKEND_PORT=8000
